#!/usr/bin/env python3
# curl as listen runs it, against a fake Ollama with llama3.2 pulled: a summary
# naming the model, Ollama's error for the model "missing", pulls (kept in
# .pulled beside this file), and voice downloads. down.invalid doesn't answer.
import json, os, sys

args = sys.argv[1:]
url = args[-1]
pulled_file = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".pulled")

def pulled():
    try:
        with open(pulled_file) as f:
            return ["llama3.2:latest"] + f.read().split()
    except FileNotFoundError:
        return ["llama3.2:latest"]

if "down.invalid" in url:
    print("curl: (7) Failed to connect to down.invalid", file=sys.stderr)
    sys.exit(7)
if "-o" in args:
    with open(args[args.index("-o") + 1], "w") as f:
        f.write("fake " + url.rsplit("/", 1)[-1])
    sys.exit(0)
if url.endswith("/api/tags"):
    print(json.dumps({"models": [{"name": m, "model": m} for m in pulled()]}))
    sys.exit(0)

request = json.load(sys.stdin)
if url.endswith("/api/pull"):
    with open(pulled_file, "a") as f:
        f.write(request["model"] + "\n")
    print(json.dumps({"status": "success"}))
    sys.exit(0)
if request["model"] == "missing":
    print(json.dumps({"error": 'model "missing" not found, try pulling it first'}))
    sys.exit(22)
assert "Title: Life in the tide pools" in request["prompt"], request["prompt"]
answer = "<think>plan the script</think># Tide pools\n**Tide pools** teem with life, says %s." % request["model"]
print(json.dumps({"model": request["model"], "response": answer, "done": True}))
